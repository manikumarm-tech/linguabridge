PORT=4000
# translation model: set GEMINI_API_KEY (free tier, aistudio.google.com) or ANTHROPIC_API_KEY. Gemini wins if both are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linguabridge
JWT_SECRET=change-me
# Sign in with Google: OAuth client ID(s) from Google Cloud Console, comma-separated (web first, Android later)
GOOGLE_CLIENT_ID=
ANTHROPIC_API_KEY=sk-ant-...
# only for user-scoped keys (sk-ant-usr-...): the console workspace id, wrkspc_...
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-sonnet-4-5
# optional server-side speech-to-text fallback (mobile uses on-device STT by default)
OPENAI_API_KEY=
